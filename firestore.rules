/**
 * @fileOverview Firestore Security Rules for Symbolic Care Hub.
 *
 * Core Philosophy:
 * This ruleset provides public read access to service information and restricts write access to authenticated users for both services and contact form submissions. This approach allows for easy browsing of services while preventing unauthorized modifications.
 *
 * Data Structure:
 * The data is organized into two top-level collections:
 * - /services/{serviceId}: Stores information about available services. Publicly readable.
 * - /contact_form_submissions/{submissionId}: Stores contact form submissions. Only writable by authenticated users.
 *
 * Key Security Decisions:
 * - Public read access for services to enable easy browsing.
 * - Authenticated-user-only write access for services and contact form submissions.
 * - No user listing is allowed.
 * - The design avoids complex authorization schemes and `get()` calls for simplicity and performance.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows anyone to read service information and only authenticated users to create, update, or delete services.
     * @path /services/{serviceId}
     * @allow get, list: if true;
     * @allow create: if isSignedIn();
     * @allow update: if isSignedIn() && resource != null;
     * @allow delete: if isSignedIn() && resource != null;
     * @deny get: if false;
     * @deny list: if false;
     * @deny create: if false;
     * @deny update: if false;
     * @deny delete: if false;
     * @principle Enables public access for reading and authenticated access for creating, updating and deleting services.
     */
    match /services/{serviceId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Allows authenticated users to create contact form submissions.
     * @path /contact_form_submissions/{submissionId}
     * @allow create: if isSignedIn();
     * @allow get, list, update, delete: if false;
     * @deny create: if false;
     * @deny get: if true;
     * @deny list: if true;
     * @deny update: if true;
     * @deny delete: if true;
     * @principle Restricts creation of contact form submissions to authenticated users.
     */
    match /contact_form_submissions/{submissionId} {
      allow create: if isSignedIn();
      allow get, list, update, delete: if false;
    }

    // Helper function to check if the user is signed in.
    function isSignedIn() {
      return request.auth != null;
    }
  }
}